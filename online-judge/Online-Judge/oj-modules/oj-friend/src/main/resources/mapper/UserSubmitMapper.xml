<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.friend.mapper.user.UserSubmitMapper">
    <!-- 旧接口兼容查询：限制本人及练习/比赛范围，按时间和编号取最新一条，避免多结果异常。 -->
    <select id="selectCurrentUserSubmit" resultType="org.example.friend.domain.user.UserSubmit">
        SELECT
        submit_id,
        pass,
        exe_message,
        case_judge_res
        FROM
        tb_user_submit
        <where>
            <if test="questionId != null">
                AND question_id = #{questionId}
            </if>
            <if test="examId !=null ">
                AND exam_id = #{examId}
            </if>
            <if test="examId == null ">
                AND exam_id is null
            </if>
            <if test="userId !=null ">
                AND user_id = #{userId}
            </if>
            <if test="currentTime !=null and currentTime !='' ">
                AND (create_time &gt;= #{currentTime} or update_time &gt;= #{currentTime})
            </if>
        </where>
        ORDER BY create_time DESC, submit_id DESC LIMIT 1
    </select>

    <select id="selectHostQuestionList" resultType="java.lang.Long">
        SELECT
            question_id,
            count(question_id) hot_count
        FROM
            tb_user_submit
        WHERE
            exam_id is null
        GROUP BY
            question_id
        ORDER BY
            hot_count DESC
    </select>
</mapper>
